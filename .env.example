# Blessings Distribution System Environment Variables

# Database Configuration
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=blessings
MYSQL_USER=blessings_user
MYSQL_PASSWORD=blessings_pass

# Application Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_SECRET=your-jwt-secret-here-change-this-in-production

# Redis Configuration (for Celery and caching)
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Twilio Configuration (Optional - for real SMS)
TWILIO_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1234567890

# React App Configuration
REACT_APP_API_URL=http://localhost:8000/api

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with actual values
# 3. For Gmail SMTP, use an app password, not your regular password
# 4. For Twilio, these can be left empty for mock SMS functionality
# 5. JWT_SECRET should be a long, random string
# 6. SECRET_KEY should be different from JWT_SECRET