# Application Settings
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-key-here-change-in-production
DEBUG=true
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=mysql+pymysql://blessings_user:blessings_pass@db:3306/blessings
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=blessings
MYSQL_USER=blessings_user
MYSQL_PASSWORD=blessings_pass

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=Blessings Foundation <noreply@blessings.org>
EMAIL_ENABLED=false  # Set to true to enable real emails

# SMS Configuration (Twilio - Optional)
TWILIO_ENABLED=false  # Set to true to enable real SMS
TWILIO_SID=your-twilio-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_FROM=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OCR Configuration
OCR_CONFIDENCE_THRESHOLD=0.8
OCR_MAX_FILE_SIZE_MB=10

# ML Model Configuration
ML_MODEL_PATH=/app/app/ml/models
ELIGIBILITY_MODEL_FILE=eligibility_model.joblib
FRAUD_MODEL_FILE=fraud_model.joblib
ML_RETRAIN_SCHEDULE=0 2 * * 0  # Every Sunday at 2 AM

# Security Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_PER_MINUTE=60

# File Upload Settings
UPLOAD_PATH=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Distribution Settings
MIN_BENEFICIARIES_PER_DISTRIBUTION=10
MAX_PICKUP_SLOT_SIZE=20
PICKUP_SLOT_DURATION_MINUTES=30

# Admin Settings
ADMIN_EMAIL=admin@blessings.org
ADMIN_PASSWORD=Admin@123456

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# Feature Flags
ENABLE_BLOCKCHAIN_RECEIPTS=false
ENABLE_PAYMENT_GATEWAY=false
ENABLE_ADVANCED_FRAUD_DETECTION=true
ENABLE_FAMILY_DEDUPLICATION=true

# External APIs (Optional)
GOOGLE_MAPS_API_KEY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=