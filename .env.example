# Blessings Donation System - Environment Configuration
# Copy this file to .env and update with your actual values

# Security Keys (REQUIRED - Change in production)
SECRET_KEY=your-very-secure-secret-key-change-this-in-production-min-32-chars
JWT_SECRET=your-jwt-secret-key-for-token-signing-change-in-production

# Database Configuration (REQUIRED)
DATABASE_URL=mysql+pymysql://blessings_user:blessings_pass@db:3306/blessings
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=blessings
MYSQL_USER=blessings_user
MYSQL_PASSWORD=blessings_pass

# Redis Configuration (REQUIRED)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration (REQUIRED for notifications)
# For Gmail: Use app-specific password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Blessings Donation System <your-email@gmail.com>

# SMS Configuration (OPTIONAL - Leave empty to use mock service)
# Get credentials from: https://console.twilio.com/
TWILIO_SID=optional-twilio-account-sid
TWILIO_AUTH_TOKEN=optional-twilio-auth-token
TWILIO_FROM=optional-twilio-phone-number

# Payment Gateway (OPTIONAL - Leave empty to use mock service)
# Stripe configuration for future payment integration
STRIPE_PUBLIC_KEY=optional-stripe-public-key
STRIPE_SECRET_KEY=optional-stripe-secret-key
STRIPE_WEBHOOK_SECRET=optional-stripe-webhook-secret

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_VERSION=v1
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# OCR Configuration
TESSERACT_CONFIG=--oem 3 --psm 6
OCR_CONFIDENCE_THRESHOLD=0.8
OCR_SUPPORTED_FORMATS=jpg,jpeg,png,pdf,tiff

# ML Model Configuration
ELIGIBILITY_MODEL_PATH=app/ml/models/eligibility_model.joblib
FRAUD_MODEL_PATH=app/ml/models/fraud_model.joblib
MODEL_CONFIDENCE_THRESHOLD=0.7
FRAUD_DETECTION_THRESHOLD=0.3

# Rate Limiting
RATE_LIMIT_DONATIONS=10/minute
RATE_LIMIT_UPLOADS=5/minute
RATE_LIMIT_AUTH=5/minute

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Security Headers
CORS_ORIGINS=http://localhost:3000,http://localhost:80
CSRF_SECRET_KEY=your-csrf-secret-key-change-in-production

# File Storage (Local development)
UPLOAD_FOLDER=data/uploads
STATIC_FOLDER=data/static
RECEIPT_FOLDER=data/receipts

# Backup Configuration
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Monitoring (Optional)
SENTRY_DSN=optional-sentry-dsn-for-error-tracking
PROMETHEUS_ENABLED=false

# Development Settings
RELOAD_ON_CHANGE=true
SHOW_DOCS=true
ENABLE_PROFILING=false

# Production Overrides (Set these in production)
# ENVIRONMENT=production
# DEBUG=false
# RELOAD_ON_CHANGE=false
# SHOW_DOCS=false

# ============================================================================
# SETUP INSTRUCTIONS:
# ============================================================================
# 
# 1. REQUIRED SETUP:
#    - Change SECRET_KEY and JWT_SECRET to secure random strings
#    - Set up Gmail app password for SMTP_PASS
#    - Update SMTP_USER with your Gmail address
# 
# 2. OPTIONAL SETUP:
#    - For SMS: Create Twilio account and set TWILIO_* variables
#    - For Payments: Create Stripe account and set STRIPE_* variables
#    - For Monitoring: Create Sentry account and set SENTRY_DSN
# 
# 3. PRODUCTION CHECKLIST:
#    - Set ENVIRONMENT=production
#    - Set DEBUG=false
#    - Use strong, unique SECRET_KEY and JWT_SECRET
#    - Use production database credentials
#    - Enable SSL/TLS for all external services
#    - Set up proper backup strategy
#    - Configure monitoring and alerting
# 
# 4. SECURITY NOTES:
#    - Never commit .env file to version control
#    - Rotate secrets regularly
#    - Use principle of least privilege for database users
#    - Enable audit logging in production
#    - Regular security updates for all dependencies
# 
# ============================================================================